#include <stdio.h>

int main() {
    FILE *fp;
    int a[] = {0,1,2}, x[3];
    char b[] = "ABC", y[4];
    float c[] = {1.1,1.2,1.3}, z[3];

    fp = fopen("a.bin", "wb");
    fwrite(a, sizeof(a), 1, fp);
    fwrite(b, sizeof(b), 1, fp);
    fwrite(c, sizeof(c), 1, fp);
    fclose(fp);

    fp = fopen("a.bin", "rb");
    fread(x, sizeof(x), 1, fp);
    fread(y, sizeof(y), 1, fp);
    fread(z, sizeof(z), 1, fp);
    fclose(fp);

    printf("%d %d %d\n", x[0], x[1], x[2]);
    printf("%s\n", y);
    printf("%.1f %.1f %.1f\n", z[0], z[1], z[2]);

    return 0;
}
